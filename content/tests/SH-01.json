{"test":{"id":"SH-01","kind":"shadowing","module":"both","category":"daily_routine","role":null,"title":"My daily routine","difficulty":null,"words":null,"timeLimitSec":null,"questionCount":12,"maxScore":0,"topic":"daily_routine","questionTypes":[],"textTitles":[],"bandMin":null,"bandMax":null,"level":"any","imageUrl":null,"createdAt":"2026-10-16T21:55:14.402513"},"document":{"id":"SH-01","kind":"shadowing","skill":"speaking","title":"My daily routine","topic":"daily_routine","module":"both","phrases":[{"id":"SH-01-01","audio":{"ref":"SH-01-01","src":"a7ef677601b738e431dc7de9.m4a","durationSec":4.7,"url":"https://files.justtostudy.kz/production/ielts/media/a7ef677601b738e431dc7de9.m4a"},"groups":["I usually get up","at about half past six,","even at the weekend."]},{"id":"SH-01-02","audio":{"ref":"SH-01-02","src":"6fb4ef111c4960a6466e6c94.m4a","durationSec":2.7,"url":"https://files.justtostudy.kz/production/ielts/media/6fb4ef111c4960a6466e6c94.m4a"},"groups":["The first thing I do","is make a cup of strong tea."]},{"id":"SH-01-03","audio":{"ref":"SH-01-03","src":"e5b19701385fa7b9546e54bf.m4a","durationSec":2.9,"url":"https://files.justtostudy.kz/production/ielts/media/e5b19701385fa7b9546e54bf.m4a"},"groups":["Then I check the weather","before I decide what to wear."]},{"id":"SH-01-04","audio":{"ref":"SH-01-04","src":"5d225a2a23043ca1d976d2a6.m4a","durationSec":4.2,"url":"https://files.justtostudy.kz/production/ielts/media/5d225a2a23043ca1d976d2a6.m4a"},"groups":["I live quite close to the office,","so I normally walk there."]},{"id":"SH-01-05","audio":{"ref":"SH-01-05","src":"4d7764dbdca844bbf586fe46.m4a","durationSec":4,"url":"https://files.justtostudy.kz/production/ielts/media/4d7764dbdca844bbf586fe46.m4a"},"groups":["It takes me about twenty minutes,","which is a nice way to wake up."]},{"id":"SH-01-06","audio":{"ref":"SH-01-06","src":"7495cc8948777d8e87173ce7.m4a","durationSec":5,"url":"https://files.justtostudy.kz/production/ielts/media/7495cc8948777d8e87173ce7.m4a"},"groups":["At lunchtime","I try to get outside for some fresh air,","if it isn't raining."]},{"id":"SH-01-07","audio":{"ref":"SH-01-07","src":"1730462d99f842e7a792cb31.m4a","durationSec":5.3,"url":"https://files.justtostudy.kz/production/ielts/media/1730462d99f842e7a792cb31.m4a"},"groups":["In the afternoon","I find it harder to concentrate,","so I save the easy jobs for then."]},{"id":"SH-01-08","audio":{"ref":"SH-01-08","src":"54e9c41554dd7b578faeb8e0.m4a","durationSec":4.3,"url":"https://files.justtostudy.kz/production/ielts/media/54e9c41554dd7b578faeb8e0.m4a"},"groups":["Most evenings","I cook something simple","with whatever is in the fridge."]},{"id":"SH-01-09","audio":{"ref":"SH-01-09","src":"5f90d749eaaf87f17e67eb02.m4a","durationSec":3.6,"url":"https://files.justtostudy.kz/production/ielts/media/5f90d749eaaf87f17e67eb02.m4a"},"groups":["Twice a week","I go to a dance class","with my younger sister."]},{"id":"SH-01-10","audio":{"ref":"SH-01-10","src":"b64528896fc3db97fee9b9e2.m4a","durationSec":4.3,"url":"https://files.justtostudy.kz/production/ielts/media/b64528896fc3db97fee9b9e2.m4a"},"groups":["It's the part of the week","I look forward to the most."]},{"id":"SH-01-11","audio":{"ref":"SH-01-11","src":"4f2f77220cafbcf66f14ccec.m4a","durationSec":10.4,"url":"https://files.justtostudy.kz/production/ielts/media/4f2f77220cafbcf66f14ccec.m4a"},"groups":["I try to switch off my phone","an hour before bed,","but I don't always manage it."]},{"id":"SH-01-12","audio":{"ref":"SH-01-12","src":"f1215084300585d27cbee4fc.m4a","durationSec":3.5,"url":"https://files.justtostudy.kz/production/ielts/media/f1215084300585d27cbee4fc.m4a"},"groups":["On a good day","I'm asleep by eleven."]}],"speaker":"AMY","schemaVersion":"1.0"}}