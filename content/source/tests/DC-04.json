{"test":{"id":"DC-04","skill":"listening","kind":"dictation","module":"both","category":null,"role":null,"title":"Ordering at a café","difficulty":null,"questionCount":10,"maxScore":111,"timeLimitSec":null,"status":"published","revision":1,"updatedAt":"2026-10-11T16:44:49.220118","publishedAt":"2026-10-11T16:44:49.220129","deletedAt":null},"document":{"id":"DC-04","kind":"dictation","roles":{"C":"MARK","R":"LUCY"},"skill":"listening","title":"Ordering at a café","groups":[{"id":"DC-04-G1","type":"dictation","items":[{"id":"DC-04-01","role":"R","type":"dictation","audio":{"ref":"DC-04-01","src":"bdf1693066e7c8435dbe5966.m4a","durationSec":3.9},"answer":["Hi there, are you ready to order, or do you need a minute?"],"prompt":"LUCY","acceptable":[]},{"id":"DC-04-02","role":"C","type":"dictation","audio":{"ref":"DC-04-02","src":"c087d98a04bd8fc221a70445.m4a","durationSec":8.7},"answer":["I think I'm ready. Could I have a large white coffee, please?"],"prompt":"MARK","acceptable":[]},{"id":"DC-04-03","role":"R","type":"dictation","audio":{"ref":"DC-04-03","src":"e1c846d5bbffc7709ced6ede.m4a","durationSec":6.1},"answer":["Of course. Would you like regular milk, or oat milk instead?"],"prompt":"LUCY","acceptable":[]},{"id":"DC-04-04","role":"C","type":"dictation","audio":{"ref":"DC-04-04","src":"0a0f69026eae0471f4138d8f.m4a","durationSec":7.4},"answer":["Oat milk, please. And do you have anything without wheat in it?"],"prompt":"MARK","acceptable":[]},{"id":"DC-04-05","role":"R","type":"dictation","audio":{"ref":"DC-04-05","src":"e6dca22c8fd1fd1fb4516827.m4a","durationSec":6.1},"answer":["Yes, the carrot cake and the chocolate brownie are both wheat-free."],"prompt":"LUCY","acceptable":[]},{"id":"DC-04-06","role":"C","type":"dictation","audio":{"ref":"DC-04-06","src":"5cb9e483fddc4eb9d7106fe0.m4a","durationSec":7.1},"answer":["I'll try the carrot cake. Do you make it yourselves?"],"prompt":"MARK","acceptable":[]},{"id":"DC-04-07","role":"R","type":"dictation","audio":{"ref":"DC-04-07","src":"b2fd1acabac3c455fdce314d.m4a","durationSec":4.7},"answer":["Yes, our baker makes everything fresh in the kitchen every morning."],"prompt":"LUCY","acceptable":[]},{"id":"DC-04-08","role":"C","type":"dictation","audio":{"ref":"DC-04-08","src":"cb3de08bb3b1d70b1668306e.m4a","durationSec":7},"answer":["Lovely. Can I pay by card, or is it cash only?"],"prompt":"MARK","acceptable":[]},{"id":"DC-04-09","role":"R","type":"dictation","audio":{"ref":"DC-04-09","src":"e13231e2f337cee692500f7b.m4a","durationSec":4.2},"answer":["Card is fine. That comes to seven pounds altogether."],"prompt":"LUCY","acceptable":[]},{"id":"DC-04-10","role":"C","type":"dictation","audio":{"ref":"DC-04-10","src":"701b4e36b0d7ee4ba1b34a37.m4a","durationSec":4},"answer":["Great. I'll sit by the window if there's a table free."],"prompt":"MARK","acceptable":[]}],"instruction":"Listen and type the sentence exactly as you hear it."}],"module":"both","source":{"bank":"listening-dictation","origin":"prototype"},"schemaVersion":"1.0"},"mediaUrls":{"bdf1693066e7c8435dbe5966.m4a":"https://files-dev.justtostudy.kz/development/ielts/media/bdf1693066e7c8435dbe5966.m4a","c087d98a04bd8fc221a70445.m4a":"https://files-dev.justtostudy.kz/development/ielts/media/c087d98a04bd8fc221a70445.m4a","e1c846d5bbffc7709ced6ede.m4a":"https://files-dev.justtostudy.kz/development/ielts/media/e1c846d5bbffc7709ced6ede.m4a","0a0f69026eae0471f4138d8f.m4a":"https://files-dev.justtostudy.kz/development/ielts/media/0a0f69026eae0471f4138d8f.m4a","e6dca22c8fd1fd1fb4516827.m4a":"https://files-dev.justtostudy.kz/development/ielts/media/e6dca22c8fd1fd1fb4516827.m4a","5cb9e483fddc4eb9d7106fe0.m4a":"https://files-dev.justtostudy.kz/development/ielts/media/5cb9e483fddc4eb9d7106fe0.m4a","b2fd1acabac3c455fdce314d.m4a":"https://files-dev.justtostudy.kz/development/ielts/media/b2fd1acabac3c455fdce314d.m4a","cb3de08bb3b1d70b1668306e.m4a":"https://files-dev.justtostudy.kz/development/ielts/media/cb3de08bb3b1d70b1668306e.m4a","e132