# On the server the deploy makes .env itself (a random database password) and sets
# ADMIN_PHONES from the GitHub repository variable IELTS_ADMIN_PHONES, as on the SAT
# platform. For a local run: copy to .env and fill in before `docker compose up -d --build`.
POSTGRES_PASSWORD=change-me
# The first admins: sign up on the site with one of these phone numbers and you get
# the admin role (students sign in with phone and password). Then give other people
# roles and course access in Сотрудники → Ученики. Comma-separated, any spelling.
ADMIN_PHONES=+77001234567
# AI grading of Writing and Speaking (server/src/ai.js): the only grading there is, so
# without the key essays and recordings are saved but not graded. On the server the deploy
# sets them from the GitHub repository secrets ANTHROPIC_API_KEY and TRANSCRIBE_API_KEY.
ANTHROPIC_API_KEY=
# Optional: server speech-to-text for Speaking (an OpenAI API key; any OpenAI-compatible
# service works). Without it Speaking is graded from the transcript the student's browser made.
TRANSCRIBE_API_KEY=
# AI_MODEL=claude-sonnet-5-5
# AI_EFFORT=medium        (low | medium | high: how carefully the examiner thinks)
# TRANSCRIBE_URL=https://api.openai.com/v1/audio/transcriptions
# AI_MAX_TOKENS=32000
# AI checks per student (an admin can set another number for one student on the staff page):
# The test bank follows the JTS admin panel («Практика и тесты → IELTS»): every SYNC_EVERY_MIN
# minutes the API fetches new and edited tests, their media and the programmes (server/src/sync.js).
# An ADMIN account of the panel; on the server the deploy sets them from the GitHub secrets
# SOURCE_LOGIN and SOURCE_PASSWORD (the password travels base64-encoded as SOURCE_PASSWORD_B64).
SOURCE_LOGIN=
SOURCE_PASSWORD_B64=
# SOURCE_URL=https://dev-server.justtostudy.kz
# SYNC_EVERY_MIN=10
# AI_LIMIT=10
# AI_LIMIT_PERIOD=day     (day: per day | month: per calendar month | total: in all; days start at midnight in APP_TZ)
# TRANSCRIBE_MODEL=whisper-1
# TRANSCRIBE_LANG=en
# Optional: an account whose email is listed here is made admin too.
# ADMIN_EMAILS=you@example.com
# Optional
# APP_TZ=Asia/Almaty      (the day course access ends is counted in this time zone)
# WEB_PORT=5173
# PLANS=self,coach
# DEFAULT_PLANS=self
# MEDIA_FALLBACK=        (empty: serve audio only from the downloaded copy)
