# Copy to .env and fill in before `docker compose up -d --build`.
POSTGRES_PASSWORD=change-me
# The first admins: register on the site with one of these and you get the admin role.
# Then give other people roles in Staff → Students. Comma-separated.
ADMIN_EMAILS=you@example.com
ADMIN_PHONES=+77001234567
# Optional
# WEB_PORT=5173
# PLANS=self,coach,intensive
# DEFAULT_PLANS=self
# MEDIA_FALLBACK=        (empty: serve audio only from the downloaded copy)
