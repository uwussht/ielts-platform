# Copy to .env and fill in before `docker compose up -d --build`.
POSTGRES_PASSWORD=change-me
# The first admins: sign up on the site with one of these phone numbers and you get
# the admin role (students sign in with phone and password). Then give other people
# roles and course access in Сотрудники → Ученики. Comma-separated, any spelling.
ADMIN_PHONES=+77001234567
# Optional: an account whose email is listed here is made admin too.
# ADMIN_EMAILS=you@example.com
# Optional
# APP_TZ=Asia/Almaty      (the day course access ends is counted in this time zone)
# WEB_PORT=5173
# PLANS=self,coach,intensive
# DEFAULT_PLANS=self
# MEDIA_FALLBACK=        (empty: serve audio only from the downloaded copy)
